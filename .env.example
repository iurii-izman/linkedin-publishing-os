APP_ENV=development
APP_PUBLIC_URL=https://publisher.example.com
LOG_LEVEL=INFO
# Generate a Fernet key locally with a secret manager; do not print or commit it.
TOKEN_ENCRYPTION_KEY=change-me-generated-fernet-key
STAGE0_OWNER_KEY=change-me-long-random-owner-key
STAGE0_TOKEN_STORE_PATH=.stage0/linkedin-connection.enc
APP_OWNER_KEY=change-me-separate-long-random-owner-key
OAUTH_STATE_TTL_SECONDS=900
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://publisher.example.com/v1/oauth/linkedin/callback
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_AUTHORIZATION_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_TOKEN_INTROSPECTION_URL=https://www.linkedin.com/oauth/v2/introspectToken
LINKEDIN_USERINFO_URL=https://api.linkedin.com/v2/userinfo
LINKEDIN_API_VERSION=202607
LINKEDIN_RESTLI_VERSION=2.0.0
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_TIMEOUT_CONNECT_SECONDS=5
LINKEDIN_TIMEOUT_READ_SECONDS=20
LINKEDIN_IMAGE_POLL_ATTEMPTS=10
LINKEDIN_IMAGE_POLL_INTERVAL_SECONDS=2
LINKEDIN_PUBLISHER_MODE=disabled
LIVE_LINKEDIN_PUBLISHING_ENABLED=false

# Stage 1 local topology. Replace every placeholder locally; never commit .env.
POSTGRES_ADMIN_PASSWORD=change-me-admin
PUBLISHER_DB_PASSWORD=change-me-publisher
N8N_DB_PASSWORD=change-me-n8n
DATABASE_URL=postgresql+psycopg://publisher:change-me-publisher@postgres:5432/publisher
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT=5
STAGE1_TOKEN_KEY_ID=primary
STALE_PUBLICATION_SECONDS=300
INTERNAL_SERVICE_TOKEN=change-me-long-random
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=change-me-long-random
N8N_SERVICE_KEY=change-me-separate-long-random-service-key
TELEGRAM_BOT_ENABLED=false
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
APPROVAL_REQUEST_TTL_SECONDS=900
PUBLISHER_API_INTERNAL_URL=http://publisher-api:8000
LINKEDIN_CONNECTION_ID=
GENERIC_TIMEZONE=UTC
N8N_SECURE_COOKIE=true
WEBHOOK_URL=https://n8n.example.com/
