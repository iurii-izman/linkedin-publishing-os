APP_ENV=development
APP_PUBLIC_URL=https://publisher.example.com
APP_TIMEZONE=Europe/Chisinau
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://publisher:change-me@postgres:5432/publisher
INTERNAL_SERVICE_TOKEN=change-me-long-random
TOKEN_ENCRYPTION_KEY=change-me-generated-key
OAUTH_STATE_TTL_MINUTES=15
OAUTH_EXPIRY_WARNING_DAYS=14
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://publisher.example.com/v1/oauth/linkedin/callback
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202607
LINKEDIN_RESTLI_VERSION=2.0.0
LINKEDIN_PUBLISHER_MODE=rest_posts
LINKEDIN_ANALYTICS_MODE=manual
ASSET_STORAGE_MODE=filesystem
ASSET_STORAGE_PATH=/var/lib/publisher/assets
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=104857600
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=change-me-long-random
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
